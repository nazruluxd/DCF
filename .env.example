# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FINANCIAL DATA APIS (Optional - Plug in any free or paid financial provider):
# 1. Financial Modeling Prep (FMP) - https://site.financialmodelingprep.com/developer/docs
# Provides complete 10-K/10-Q cash flow statements, balance sheet, beta, and intrinsic DCF metrics.
FMP_API_KEY="YOUR_FMP_API_KEY"

# 2. Finnhub Stock API - https://finnhub.io/
# Free tier offers 60 calls/minute for real-time price quotes, basic financials, and company profile.
FINNHUB_API_KEY="YOUR_FINNHUB_API_KEY"

# 3. Alpha Vantage - https://www.alphavantage.co/support/#api-key
# Free tier provides company overview, cash flow statements, and global quotes.
ALPHA_VANTAGE_API_KEY="YOUR_ALPHA_VANTAGE_API_KEY"

# Preferred data provider priority ('auto' | 'fmp' | 'finnhub' | 'alphavantage' | 'yahoo' | 'gemini')
DATA_PROVIDER="auto"
